# Proposed configuration names only; no application consumes these yet.
# EXPO_PUBLIC values are bundled into clients and are NOT secrets.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Native local development needs a reachable dev-server address, configured later.
# Supabase configuration belongs to the server under the proposed BFF architecture.
# Server-only values belong in separate server secret stores, never Expo builds.
# SUPABASE_SECRET_KEY, DATABASE_URL, SESSION_ENCRYPTION_KEY and AI_PROVIDER_API_KEY omitted.
# Production must never be the default development target.
