# Proposed configuration names only; no application consumes these yet.
# EXPO_PUBLIC values are bundled into clients and are NOT secrets.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key
# Server-only values belong in separate server secret stores, never Expo builds.
# SUPABASE_SECRET_KEY, DATABASE_URL and AI_PROVIDER_API_KEY intentionally omitted.
# Production must never be the default development target.
